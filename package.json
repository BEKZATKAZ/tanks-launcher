{
  "name": "tanks-launcher-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare:electrobun": "electrobun prepare",
    "build": "node --run typecheck && node --run build:ui && electrobun build --env=dev",
    "build:release": "node --run typecheck && node --run build:ui && electrobun build --env=stable",
    "build:ui": "vite build",
    "dev": "node --run build:ui && node scripts/dev.js",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.json packages/core/tsconfig.test.json packages/adapters/tsconfig.test.json packages/launcher/tsconfig.test.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.6.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "electrobun": "2.0.6",
    "eslint": "^9.39.0",
    "eslint-plugin-import-x": "^4.16.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0",
    "vite": "^8.0.0"
  }
}
